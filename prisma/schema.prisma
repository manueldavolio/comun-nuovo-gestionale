generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PARENT
  COACH
  YOUTH_DIRECTOR
}

enum EnrollmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentType {
  DEPOSIT
  BALANCE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum EventType {
  TRAINING
  LEAGUE_MATCH
  FRIENDLY
  TOURNAMENT
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED_ABSENCE
  INJURED
}

enum ConvocationResponseStatus {
  PENDING
  PRESENT
  ABSENT
}

enum MedicalVisitStatus {
  VALID
  EXPIRING
  EXPIRED
}

enum DocumentType {
  ID_CARD
  TAX_CODE
  MEDICAL_CERTIFICATE
  PRIVACY_FORM
  IMAGE_CONSENT
  OTHER
}

enum EnrollmentDocumentType {
  PARENT_ID_FRONT
  PARENT_ID_BACK
  ATHLETE_ID_FRONT
  ATHLETE_ID_BACK
  ATHLETE_PORTRAIT
}

enum AnnouncementAudience {
  ALL
  PARENTS
  COACHES
  CATEGORY_ONLY
}

enum MediaType {
  PHOTO
  VIDEO
}

enum EvaluationPeriodType {
  FIRST_TRIMESTER
  END_OF_SEASON
}

enum AccountingEntryType {
  INCOME
  EXPENSE
}

enum AthleteGender {
  MALE
  FEMALE
  OTHER
}

/// Stato anagrafico operativo in rosa (distinto da AthleteOperationalStatus = disponibilità sportiva).
enum AthleteRosterStatus {
  ACTIVE
  WITHDRAWN
}

enum ParentAthleteLinkRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PredictionChoice {
  HOME
  DRAW
  AWAY
}

enum AthletePersonalGoalStatus {
  IN_PROGRESS
  ACHIEVED
  CONTINUE
}

/// Tag positivi sul messaggio mensile del mister (non sono voti).
enum PositiveCoachTag {
  IMPEGNO
  CRESCITA
  SPIRITO_DI_SQUADRA
  COSTANZA
  CORAGGIO
  ASCOLTO
}

/// Stato operativo sportivo (NON sanitario). Nessuna riga = AVAILABLE.
enum AthleteOperationalStatusType {
  AVAILABLE
  TO_CHECK
  INJURED
  ILL
  ABSENT
}

/// Ambito competitivo (campionato/coppa/…). Distinto da EventType.
enum CompetitionKind {
  LEAGUE
  CUP
  TOURNAMENT
  FRIENDLY
  OTHER
}

enum DisciplinarySanctionType {
  YELLOW_CARD
  RED_CARD
  SECOND_YELLOW_RED
  DIRECT_SUSPENSION
  OTHER
}

enum DisciplinaryRecordStatus {
  ACTIVE
  VOIDED
}

enum SuspensionServeStatus {
  PENDING
  SERVED
  CANCELLED
}

enum DisciplinaryAuditEntityType {
  INCIDENT
  SUSPENSION
  SERVING
  OPENING_BALANCE
  MATCH_RATING
}

enum DisciplinaryAuditAction {
  CREATE
  UPDATE
  VOID
  SERVE
  UNSERVE
  CORRECT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentProfile     ParentProfile?
  coachProfile      CoachProfile?
  adminProfile      AdminProfile?
  createdEvents     Event[]
  createdByMessages Announcement[]
  createdMediaItems MediaItem[]
  createdConvocations Convocation[]
  evaluationsGiven  Evaluation[]
  accountingEntries AccountingEntry[]
  reviewedParentAthleteLinkRequests ParentAthleteLinkRequest[] @relation("ParentAthleteLinkRequestReviewedBy")
  athleteCoachNotes AthleteCoachNote[]
  athletePersonalGoals AthletePersonalGoal[]
  athleteOperationalStatusesSet AthleteOperationalStatus[] @relation("AthleteOperationalStatusSetBy")
  createdPredictionSlips PredictionSlip[]
  createdTrainingExercises TrainingExercise[]
  createdTrainingSessions TrainingSession[]
  createdMatchFormations MatchFormation[]
  disciplinaryIncidentsCreated DisciplinaryIncident[] @relation("DisciplinaryIncidentCreatedBy")
  disciplinaryIncidentsUpdated DisciplinaryIncident[] @relation("DisciplinaryIncidentUpdatedBy")
  disciplinarySuspensionsCreated DisciplinarySuspension[] @relation("DisciplinarySuspensionCreatedBy")
  disciplinarySuspensionsUpdated DisciplinarySuspension[] @relation("DisciplinarySuspensionUpdatedBy")
  disciplinaryServingsConfirmed DisciplinarySuspensionServing[] @relation("DisciplinaryServingConfirmedBy")
  disciplinaryOpeningBalancesCreated DisciplinaryOpeningBalance[] @relation("DisciplinaryOpeningCreatedBy")
  disciplinaryOpeningBalancesUpdated DisciplinaryOpeningBalance[] @relation("DisciplinaryOpeningUpdatedBy")
  disciplinaryAuditLogs DisciplinaryAuditLog[]
  matchPlayerRatingsCreated MatchPlayerRating[] @relation("MatchPlayerRatingCreatedBy")
  matchPlayerRatingsUpdated MatchPlayerRating[] @relation("MatchPlayerRatingUpdatedBy")

  @@index([role])
  @@index([isActive])
}

model Category {
  id             String   @id @default(cuid())
  name           String
  birthYearsLabel String
  seasonLabel    String
  annualFee      Decimal  @db.Decimal(10, 2)
  depositFee     Decimal  @db.Decimal(10, 2)
  balanceFee     Decimal  @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  /// Giocatori per squadra in campo (5/7/9/11). null = usare fallback da nome fino al backfill.
  playersPerSide Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  athletes            Athlete[]
  enrollments         Enrollment[]
  events              Event[]
  announcements       Announcement[]
  mediaItems          MediaItem[]
  convocations        Convocation[]
  monthlyCoachReports MonthlyCoachReport[]
  coachAssignments    CoachCategoryAssignment[]
  trainingExercises   TrainingExercise[]
  disciplinaryIncidents DisciplinaryIncident[]
  disciplinarySuspensions DisciplinarySuspension[]
  disciplinaryOpeningBalances DisciplinaryOpeningBalance[]

  @@unique([name, seasonLabel])
  @@index([isActive])
  @@index([seasonLabel])
}

model ParentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  firstName  String
  lastName   String
  taxCode    String   @unique
  phone      String
  address    String
  city       String
  postalCode String
  province   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  athletes               Athlete[]
  additionalAthleteLinks AthleteParent[]
  athleteLinkRequests    ParentAthleteLinkRequest[]
  predictionEntries      PredictionEntry[]

  @@index([lastName, firstName])
}

model CoachProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyCoachReports MonthlyCoachReport[]
  categoryAssignments CoachCategoryAssignment[]

  @@index([lastName, firstName])
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastName, firstName])
}

model Athlete {
  id           String       @id @default(cuid())
  firstName    String
  lastName     String
  gender       AthleteGender
  birthDate    DateTime
  birthPlace   String
  taxCode      String       @unique
  nationality  String
  address      String
  city         String
  postalCode   String
  province     String
  clothingSize String?
  medicalNotes String?
  /// Ruolo in campo (codici canonici POR/DIF/CEN/ATT; legacy free-text ancora leggibile).
  position     String?
  /// Numero maglia opzionale.
  shirtNumber  Int?
  /// Rosa attiva vs ritirato (NON cancella storico economico).
  rosterStatus AthleteRosterStatus @default(ACTIVE)
  /// Momento del ritiro (Europe/Rome wall-clock salvato come DateTime).
  withdrawnAt  DateTime?
  /// Motivo organizzativo breve — mai dati sanitari.
  withdrawReason String?
  parentId     String
  categoryId   String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  parent               ParentProfile              @relation(fields: [parentId], references: [id], onDelete: Restrict)
  category             Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  enrollments          Enrollment[]
  attendances          Attendance[]
  convocationEntries   ConvocationAthlete[]
  medicalVisits        MedicalVisit[]
  documents            Document[]
  evaluations          Evaluation[]
  additionalParents    AthleteParent[]
  parentLinkRequests   ParentAthleteLinkRequest[]
  matchStats           MatchPlayerStat[]
  coachNotes           AthleteCoachNote[]
  personalGoals        AthletePersonalGoal[]
  operationalStatus    AthleteOperationalStatus?
  formationSlots       MatchFormationSlot[]
  disciplinaryIncidents DisciplinaryIncident[]
  disciplinarySuspensions DisciplinarySuspension[]
  disciplinaryOpeningBalances DisciplinaryOpeningBalance[]
  matchPlayerRatings   MatchPlayerRating[]

  @@index([lastName, firstName])
  @@index([parentId])
  @@index([categoryId])
  @@index([rosterStatus])
}

/// Genitori aggiuntivi (oltre ad Athlete.parentId = genitore principale/legacy).
model AthleteParent {
  id        String   @id @default(cuid())
  athleteId String
  parentId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([athleteId, parentId])
  @@index([parentId])
  @@index([athleteId])
}

model ParentAthleteLinkRequest {
  id                String                         @id @default(cuid())
  requesterParentId String
  athleteId         String
  status            ParentAthleteLinkRequestStatus @default(PENDING)
  reviewedAt        DateTime?
  reviewedById      String?
  adminNote         String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  requesterParent ParentProfile @relation(fields: [requesterParentId], references: [id], onDelete: Cascade)
  athlete         Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  reviewedBy      User?         @relation("ParentAthleteLinkRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requesterParentId, athleteId])
  @@index([athleteId])
}

model Enrollment {
  id          String           @id @default(cuid())
  athleteId   String
  categoryId  String
  seasonLabel String
  receiptFirstName String
  receiptLastName  String
  receiptTaxCode   String
  receiptPhone     String
  receiptAddress   String
  receiptCity      String
  receiptPostalCode String
  receiptProvince  String
  receiptEmail     String
  privacyConsent   Boolean
  regulationConsent Boolean
  imageConsent     Boolean      @default(false)
  status      EnrollmentStatus @default(DRAFT)
  submittedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  athlete   Athlete              @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category  Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payments  Payment[]
  documents EnrollmentDocument[]

  @@unique([athleteId, categoryId, seasonLabel])
  @@index([status])
  @@index([seasonLabel])
}

model Payment {
  id            String        @id @default(cuid())
  enrollmentId  String
  type          PaymentType
  amount        Decimal       @db.Decimal(10, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        PaymentStatus @default(PENDING)
  paymentMethod String?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  receipt    Receipt?
  accountingEntry AccountingEntry?

  @@index([enrollmentId])
  @@index([status, dueDate])
}

model Receipt {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  receiptNumber String   @unique
  issueDate     DateTime
  amount        Decimal  @db.Decimal(10, 2)
  causal        String?
  paymentProvider String?
  headerName    String
  headerTaxCode String
  filePath      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model ReceiptCounter {
  id        Int      @id
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StripeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())
}

model Event {
  id           String    @id @default(cuid())
  title        String
  description  String?
  type         EventType
  startAt      DateTime
  endAt        DateTime?
  location     String?
  categoryId   String?
  createdById  String
  /// Avversario (solo eventi partita, opzionale).
  opponentName String?
  homeScore    Int?
  awayScore    Int?
  /// true = Comun Nuovo in casa; null su eventi senza risultato strutturato.
  isHome       Boolean?
  /// Ambito competitivo (campionato/coppa/…). null su allenamenti.
  competitionKind CompetitionKind?
  /// Stagione etichetta (es. 2026/2027), allineata a Category.seasonLabel quando possibile.
  seasonLabel  String?
  /// Se false, la gara non conta per scontare squalifiche (tipico amichevoli).
  countsForDiscipline Boolean @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  attendances Attendance[]
  convocation Convocation?
  matchStats  MatchPlayerStat[]
  periodScores MatchPeriodScore[]
  predictionSlipEvents PredictionSlipEvent[]
  trainingSession TrainingSession?
  matchFormation MatchFormation?
  disciplinaryIncidents DisciplinaryIncident[]
  disciplinaryServings DisciplinarySuspensionServing[]
  matchPlayerRatings MatchPlayerRating[]

  @@index([categoryId])
  @@index([createdById])
  @@index([startAt])
  @@index([competitionKind])
  @@index([seasonLabel])
}

/// Gol per singolo tempo (Pulcini / Esordienti). null = tempo non inserito; 0 = 0 reale.
model MatchPeriodScore {
  id           String   @id @default(cuid())
  eventId      String
  periodNumber Int
  homeScore    Int?
  awayScore    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, periodNumber])
  @@index([eventId])
}

model Convocation {
  id          String    @id @default(cuid())
  eventId     String?   @unique
  categoryId  String
  /// Orario di ritrovo/presentazione (distinto da Event.startAt = inizio partita).
  /// Nullable per retrocompatibilità con convocazioni già create.
  meetingAt   DateTime?
  notes       String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event      Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  category   Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy  User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  athletes   ConvocationAthlete[]

  @@index([categoryId, createdAt])
  @@index([createdById])
}

model ConvocationAthlete {
  id             String                    @id @default(cuid())
  convocationId  String
  athleteId      String
  responseStatus ConvocationResponseStatus @default(PENDING)
  respondedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  convocation Convocation @relation(fields: [convocationId], references: [id], onDelete: Cascade)
  athlete     Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([convocationId, athleteId])
  @@index([athleteId, responseStatus])
}

model CoachCategoryAssignment {
  id         String   @id @default(cuid())
  coachId    String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  coach    CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([coachId, categoryId])
  @@index([categoryId])
}

model Attendance {
  id        String           @id @default(cuid())
  athleteId String
  eventId   String
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([athleteId, eventId])
  @@index([eventId, status])
}

/// Gol/assist (e gol subiti portiere) per singolo atleta in una partita.
model MatchPlayerStat {
  id             String   @id @default(cuid())
  eventId        String
  athleteId      String
  goals          Int      @default(0)
  assists        Int      @default(0)
  /// Solo portieri: null = non inserito; 0 = clean sheet confermato.
  goalsConceded  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([eventId, athleteId])
  @@index([athleteId])
  @@index([eventId])
}

/// Nota privata mensile del mister sull'atleta (visibile a mister categoria, genitori associati, admin).
model AthleteCoachNote {
  id           String             @id @default(cuid())
  athleteId    String
  authorId     String
  year         Int
  month        Int
  content      String
  /// Tag positivi opzionali (0–3). Non sono voti né classifiche.
  positiveTags PositiveCoachTag[] @default([])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([athleteId, year, month])
  @@index([athleteId, year, month])
  @@index([authorId])
}

/// Obiettivo personale assegnato dal mister (crescita, non competizione).
model AthletePersonalGoal {
  id          String                    @id @default(cuid())
  athleteId   String
  authorId    String
  text        String
  periodMonth Int?
  periodYear  Int?
  status      AthletePersonalGoalStatus @default(IN_PROGRESS)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([athleteId])
  @@index([athleteId, status])
  @@index([athleteId, periodYear, periodMonth])
  @@index([authorId])
  @@index([status])
}

/// Disponibilità operativa sportiva corrente (NON sanitaria).
/// Nessuna riga oppure scaduta = AVAILABLE.
model AthleteOperationalStatus {
  id         String                       @id @default(cuid())
  athleteId  String                       @unique
  status     AthleteOperationalStatusType
  /// Nota organizzativa breve — mai informazioni mediche.
  note       String?
  setById    String
  /// Fine validità (fine giornata Europe/Rome wall-clock). null = senza scadenza.
  validUntil DateTime?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  setBy   User    @relation("AthleteOperationalStatusSetBy", fields: [setById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([validUntil])
  @@index([setById])
}

/// Template esercizio in libreria coach (non usato direttamente in seduta — snapshot su TrainingSessionItem).
model TrainingExercise {
  id           String   @id @default(cuid())
  title        String
  description  String?
  durationMin  Int?
  materials    String?
  /// null = esercizio personale dell'autore (non condiviso con altri coach).
  categoryId   String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sessionItems TrainingSessionItem[]

  @@index([categoryId])
  @@index([createdById])
  @@index([createdAt])
}

/// Programma tecnico di una seduta — 1:1 con Event TRAINING. Solo staff.
model TrainingSession {
  id          String   @id @default(cuid())
  eventId     String   @unique
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     TrainingSessionItem[]

  @@index([createdById])
}

/// Voce del programma: snapshot immutabile rispetto a modifiche successive del template.
model TrainingSessionItem {
  id          String   @id @default(cuid())
  sessionId   String
  /// Riferimento opzionale al template; SET NULL se il template viene eliminato.
  exerciseId  String?
  title       String
  description String?
  durationMin Int?
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session  TrainingSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise TrainingExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([sessionId, sortOrder])
  @@index([exerciseId])
}

/// Formazione partita — SEMPRE privata (solo staff). Nessuna pubblicazione ai genitori.
model MatchFormation {
  id          String   @id @default(cuid())
  eventId     String   @unique
  /// Es. "4-3-3", "4-4-2", "CUSTOM"
  module      String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  slots     MatchFormationSlot[]

  @@index([createdById])
}

model MatchFormationSlot {
  id          String   @id @default(cuid())
  formationId String
  /// Chiave stabile es. POR, DF1, MF2, FW1, BENCH_1
  slotKey     String
  athleteId   String?
  isBench     Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  formation MatchFormation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  athlete   Athlete?       @relation(fields: [athleteId], references: [id], onDelete: SetNull)

  @@unique([formationId, slotKey])
  @@index([formationId, sortOrder])
  @@index([athleteId])
}

model MedicalVisit {
  id                  String            @id @default(cuid())
  athleteId           String
  visitDate           DateTime
  expiryDate          DateTime
  status              MedicalVisitStatus @default(VALID)
  certificateFilePath String?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([expiryDate, status])
}

model EnrollmentDocument {
  id           String                 @id @default(cuid())
  enrollmentId String
  type         EnrollmentDocumentType
  filePath     String
  fileName     String
  mimeType     String
  size         Int
  createdAt    DateTime               @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, type])
  @@index([enrollmentId])
}

model Document {
  id         String       @id @default(cuid())
  athleteId  String
  type       DocumentType
  title      String
  filePath   String
  expiryDate DateTime?
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([type])
  @@index([expiryDate])
}

model Announcement {
  id          String                @id @default(cuid())
  title       String
  content     String
  audience    AnnouncementAudience
  categoryId  String?
  publishedAt DateTime?
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([audience])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([createdById])
}

model MediaItem {
  id          String    @id @default(cuid())
  title       String
  description String?
  filePath    String?
  mediaUrl    String?
  mediaType   MediaType
  categoryId  String
  createdById String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([createdById])
  @@index([publishedAt])
  @@index([mediaType])
}

model MonthlyCoachReport {
  id               String   @id @default(cuid())
  coachId          String
  categoryId       String
  month            Int
  year             Int
  technicalFocus   String?
  tacticalFocus    String?
  groupIssues      String?
  playersToMonitor String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  coach    CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([coachId, categoryId, month, year])
  @@index([categoryId, year, month])
}

model Evaluation {
  id              String                @id @default(cuid())
  athleteId       String
  evaluatorId     String
  periodType      EvaluationPeriodType
  technicalScore  Int?
  behavioralScore Int?
  strengths       String?
  improvements    String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  evaluator User    @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@index([athleteId, periodType])
  @@index([evaluatorId])
}

// ---------------------------------------------------------------------------
// CMS SITO WEB PUBBLICO (sezione admin "Sito web")
// Tabelle lette dal sito pubblico (comun-nuovo-sito) tramite Supabase anon key.
// ---------------------------------------------------------------------------

enum SiteTeam {
  PRIMA_SQUADRA
  FEMMINILE
  UNDER_19
  UNDER_17
  UNDER_15
  CALCIO_A_5_C2
}

enum SitePlayerRole {
  PORTIERE
  DIFENSORE
  CENTROCAMPISTA
  ATTACCANTE
}

enum SiteSponsorCategory {
  MAIN
  GOLD
  PARTNER
  TECHNICAL
}

model SitePlayer {
  id          String         @id @default(cuid())
  name        String
  role        SitePlayerRole
  team        SiteTeam       @default(PRIMA_SQUADRA)
  shirtNumber Int?
  description String?
  photoUrl    String?
  sortOrder   Int            @default(0)
  isVisible   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([team, isVisible])
}

model SiteStaffMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  category    String   @default("Dirigenza")
  description String?
  photoUrl    String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isVisible])
}

model SiteNews {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  subtitle      String?
  content       String
  coverImageUrl String?
  category      String    @default("Società")
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}

model SiteSponsor {
  id         String              @id @default(cuid())
  name       String
  category   SiteSponsorCategory @default(PARTNER)
  logoUrl    String?
  websiteUrl String?
  sortOrder  Int                 @default(0)
  isVisible  Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([category, isVisible])
}

model SiteGalleryAlbum {
  id        String    @id @default(cuid())
  title     String
  date      DateTime?
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  images SiteGalleryImage[]
}

model SiteGalleryImage {
  id        String   @id @default(cuid())
  albumId   String
  imageUrl  String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  album SiteGalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}

model SiteVideo {
  id          String   @id @default(cuid())
  title       String
  youtubeUrl  String
  description String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default("main")
  foundationYear Int      @default(1968)
  teamsCount     String   @default("8")
  membersCount   String   @default("200+")
  fieldsCount    String   @default("4")
  updatedAt      DateTime @updatedAt
}

model AccountingEntry {
  id            String              @id @default(cuid())
  type          AccountingEntryType
  category      String
  description   String
  amount        Decimal             @db.Decimal(10, 2)
  date          DateTime            @map("entryDate")
  createdById   String?
  paymentId     String?             @unique
  paymentMethod String?
  isForecast    Boolean             @default(false)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payment       Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([type, date])
  @@index([category])
  @@index([isForecast])
  @@index([createdById])
}

/// Schedina Comun Nuovo (gioco gratuito 1-X-2 settimanale).
model PredictionSlip {
  id          String    @id @default(cuid())
  title       String
  prizeText   String
  /// Chiusura scelta manualmente dall'admin.
  closesAt    DateTime
  /// Chiusura effettiva congelata al publish: min(closesAt, primo kickoff). Mai ricalcolata dagli Event.
  effectiveClosesAt DateTime?
  /// Materializzazione lazy dello stato LOCKED (now >= effectiveClosesAt).
  lockedAt    DateTime?
  isPublished Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  events    PredictionSlipEvent[]
  entries   PredictionEntry[]

  @@index([isPublished, closesAt])
  @@index([createdById])
  @@index([lockedAt])
  @@index([effectiveClosesAt])
}

model PredictionSlipEvent {
  id        String @id @default(cuid())
  slipId    String
  eventId   String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slip  PredictionSlip   @relation(fields: [slipId], references: [id], onDelete: Cascade)
  event Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  picks PredictionPick[]

  @@unique([slipId, eventId])
  @@index([slipId, sortOrder])
  @@index([eventId])
}

model PredictionEntry {
  id          String   @id @default(cuid())
  slipId      String
  parentId    String
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slip   PredictionSlip  @relation(fields: [slipId], references: [id], onDelete: Cascade)
  parent ParentProfile   @relation(fields: [parentId], references: [id], onDelete: Restrict)
  picks  PredictionPick[]

  @@unique([slipId, parentId])
  @@index([parentId])
  @@index([slipId])
}

model PredictionPick {
  id          String           @id @default(cuid())
  entryId     String
  slipEventId String
  choice      PredictionChoice
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  entry     PredictionEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  slipEvent PredictionSlipEvent @relation(fields: [slipEventId], references: [id], onDelete: Cascade)

  @@unique([entryId, slipEventId])
  @@index([slipEventId])
}
/// Cartellino / provvedimento disciplinare (non genera automaticamente squalifiche).
model DisciplinaryIncident {
  id              String                   @id @default(cuid())
  athleteId       String
  categoryId      String
  eventId         String?
  seasonLabel     String
  competitionKind CompetitionKind
  type            DisciplinarySanctionType
  minute          Int?
  notes           String?
  status          DisciplinaryRecordStatus @default(ACTIVE)
  voidedAt        DateTime?
  voidReason      String?
  createdById     String
  updatedById     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  athlete      Athlete                   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category     Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  event        Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy    User                      @relation("DisciplinaryIncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?                     @relation("DisciplinaryIncidentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  suspensions  DisciplinarySuspension[]

  @@index([athleteId, seasonLabel, competitionKind, status])
  @@index([eventId])
  @@index([categoryId])
  @@index([createdById])
}

/// Situazione disciplinare iniziale (pregresso a campionato già iniziato).
model DisciplinaryOpeningBalance {
  id                             String          @id @default(cuid())
  athleteId                      String
  categoryId                     String
  seasonLabel                    String
  competitionKind                CompetitionKind
  /// Ammonizioni totali storiche pregresse (display).
  priorYellowCards               Int             @default(0)
  /// Ammonizioni pregresse rilevanti per accumulo (display; nessuna soglia automatica).
  priorYellowCardsForAccumulation Int            @default(0)
  /// Espulsioni pregresse (rosse dirette + doppia ammonizione).
  priorRedCards                  Int             @default(0)
  /// Giornate di squalifica ancora da scontare al momento del riferimento.
  openSuspensionMatchdays        Int             @default(0)
  referenceDate                  DateTime
  notes                          String?
  createdById                    String
  updatedById                    String?
  createdAt                      DateTime        @default(now())
  updatedAt                      DateTime        @updatedAt

  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User     @relation("DisciplinaryOpeningCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?    @relation("DisciplinaryOpeningUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([athleteId, seasonLabel, competitionKind])
  @@index([categoryId, seasonLabel, competitionKind])
  @@index([createdById])
}

/// Blocco di giornate di squalifica assegnate (dopo comunicato).
model DisciplinarySuspension {
  id               String                   @id @default(cuid())
  incidentId       String?
  athleteId        String
  categoryId       String
  seasonLabel      String
  competitionKind  CompetitionKind
  matchdaysTotal   Int
  officialRef      String?
  decidedAt        DateTime?
  notes            String?
  status           DisciplinaryRecordStatus @default(ACTIVE)
  voidedAt         DateTime?
  voidReason       String?
  createdById      String
  updatedById      String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  incident  DisciplinaryIncident?           @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  athlete   Athlete                         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category  Category                        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User                            @relation("DisciplinarySuspensionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?                           @relation("DisciplinarySuspensionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  servings  DisciplinarySuspensionServing[]

  @@index([athleteId, seasonLabel, competitionKind, status])
  @@index([incidentId])
  @@index([categoryId])
  @@index([createdById])
}

/// Giornata di squalifica: PENDING finché non confermata SERVED dal mister.
model DisciplinarySuspensionServing {
  id            String                 @id @default(cuid())
  suspensionId  String
  eventId       String?
  status        SuspensionServeStatus  @default(PENDING)
  confirmedAt   DateTime?
  confirmedById String?
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  suspension  DisciplinarySuspension @relation(fields: [suspensionId], references: [id], onDelete: Cascade)
  event       Event?                 @relation(fields: [eventId], references: [id], onDelete: SetNull)
  confirmedBy User?                  @relation("DisciplinaryServingConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([suspensionId, status])
  @@index([eventId])
  @@index([confirmedById])
}

model DisciplinaryAuditLog {
  id         String                      @id @default(cuid())
  entityType DisciplinaryAuditEntityType
  entityId   String
  action     DisciplinaryAuditAction
  beforeJson Json?
  afterJson  Json?
  userId     String
  createdAt  DateTime                    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([userId])
}

/// Valutazione postpartita (1–10 per criterio). Riservata allo staff; mai ai genitori.
model MatchPlayerRating {
  id                    String   @id @default(cuid())
  eventId               String
  athleteId             String
  possessionScore       Int?
  outOfPossessionScore  Int?
  attitudeScore         Int?
  teamworkScore         Int?
  notes                 String?
  createdById           String
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy User    @relation("MatchPlayerRatingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("MatchPlayerRatingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([eventId, athleteId])
  @@index([athleteId])
  @@index([eventId])
  @@index([createdById])
}
